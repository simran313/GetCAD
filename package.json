{
  "name": "getcad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:up": "docker compose up -d --wait test-db",
    "test:db:down": "docker compose down",
    "test:local": "npm run test:db:up && npm run test",
    "db:apply": "node scripts/apply-migrations.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run secret-scan",
    "e2e:prepare": "tsx tests/e2e/prepare.ts",
    "e2e:postgrest": "node tests/e2e/stack/postgrest.mjs",
    "e2e:build": "node tests/e2e/stack/build.mjs",
    "e2e:test": "playwright test",
    "e2e": "npm run e2e:prepare && npm run e2e:postgrest && npm run e2e:build && npm run e2e:test",
    "db:status": "node scripts/apply-migrations.mjs --status",
    "db:baseline": "node scripts/apply-migrations.mjs --baseline",
    "verify:payment": "node scripts/verify-payment.mjs",
    "verify:payout": "node scripts/verify-payout.mjs",
    "payouts:link": "node scripts/link-payout-account.mjs",
    "send-emails": "npx tsx scripts/send-emails.mjs",
    "verify:delivery": "node scripts/verify-webhook-delivery.mjs",
    "send-push": "npx tsx scripts/send-push.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.5",
    "@fontsource-variable/newsreader": "5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "1.2.21",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "geist": "^1.7.2",
    "jose": "^5.10.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "nanoid": "^5.0.9",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.81.0",
    "rhino3dm": "^8.32.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.169.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/backend": "^2.33.5",
    "@clerk/testing": "^2.2.50",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.169.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.0",
    "pdfjs-dist": "5.4.624",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
